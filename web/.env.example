# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the browser.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase anon key>
VITE_WORKER_URL=https://api.truhq.co

# cookie | token — cookie routes login through the Worker (httpOnly session).
# Stays "token" until the Phase 7 cutover; flip back to "token" to roll back.
VITE_AUTH_MODE=token
