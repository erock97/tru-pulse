# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the browser.
#
# One variable, on purpose. The browser holds no database credentials: it talks to
# the Worker, the Worker holds the session and forwards the caller's identity to
# Supabase, and row-level security decides the rest. If you find yourself adding a
# VITE_SUPABASE_* key back here, something has started reading the database from the
# browser again — fix that instead.
VITE_WORKER_URL=https://api.truhq.co
